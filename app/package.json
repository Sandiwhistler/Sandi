{
  "name": "sandi-app",
  "version": "1.0.0",
  "private": true,
  "description": "SANDI shopping app for iPhone, iPad and Android",
  "scripts": {
    "products": "cp ../products.json www/products.json",
    "preview": "npm run products && npx --yes http-server www -p 8080 -c-1",
    "sync": "npm run products && cap sync",
    "icons": "capacitor-assets generate --iconBackgroundColor '#f6c4c3' --splashBackgroundColor '#f6c4c3'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
